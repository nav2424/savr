# Copy to `.env.production` for local workflows, or paste these into eas.json → build.production.env.
# RevenueCat iOS *public* key (appl_…) is bundled into the client by design — not a secret like a server API key.
#
# Optional: add "envFile": ".env.production" under build.production in eas.json (see docs/EAS_EXPO_PUBLIC_ENV.md).
# EAS cloud builds won't see gitignored `.env.production` unless you commit it (private repo) or use eas.json env.

EXPO_PUBLIC_ENABLE_PAYWALL=true
EXPO_PUBLIC_RC_IOS_API_KEY=appl_your_ios_public_key_here

# Optional
# EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
